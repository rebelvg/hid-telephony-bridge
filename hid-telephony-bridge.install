post_install() {
    cat <<'EOF'

>>> Enable hardware mute for the Shure MV7+ in your local session:
>>>     systemctl --user enable --now hid-telephony-bridge.service
>>>
>>> Replug the mic if the service reports a device permission error.
>>> For other devices, see /usr/share/doc/hid-telephony-bridge/README.md.

EOF
}

post_upgrade() {
    cat <<'EOF'

>>> Restart the updated service from your user session:
>>>     systemctl --user daemon-reload
>>>     systemctl --user restart hid-telephony-bridge.service
>>>
>>> Remove --auto-offhook or --hid-only from any existing service override before restarting.

EOF
}

pre_remove() {
    cat <<'EOF'

>>> Stop the service before removing the package:
>>>     systemctl --user disable --now hid-telephony-bridge.service

EOF
}
